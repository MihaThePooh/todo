[Unit]
Description=Todo store (personal task list)
After=network.target

[Service]
Type=simple
User=youruser
Group=youruser
WorkingDirectory=/home/youruser/todo
ExecStart=/usr/bin/python3 /home/youruser/todo/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/youruser/todo/data

[Install]
WantedBy=multi-user.target
